# Experimental layer over the verified FP8-lm-head runtime.  The base image is
# kept unchanged so the current BF16 reduced-head deployment remains rollback.
ARG BASE_IMAGE=nvidia-hybrid-single-spark:fp8-lm-head
FROM ${BASE_IMAGE}

ARG SP=/usr/local/lib/python3.12/dist-packages
COPY src/patch_mtp_draft_vocab.py /tmp/patch_mtp_draft_vocab.py
RUN python3 /tmp/patch_mtp_draft_vocab.py \
      ${SP}/vllm/models/qwen3_8_flash_next/nvidia/mtp.py \
 && python3 -m py_compile \
      ${SP}/vllm/models/qwen3_8_flash_next/nvidia/mtp.py \
 && grep -q "FP8 reduced draft head has unexpected dtype" \
      ${SP}/vllm/models/qwen3_8_flash_next/nvidia/mtp.py \
 && rm /tmp/patch_mtp_draft_vocab.py
